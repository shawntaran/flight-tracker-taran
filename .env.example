# DOCUMENTATION ONLY: the names of the secrets this project uses.
# Nothing reads this file. Google Apps Script does not read .env files, and the local tests
# use fake credentials inside a sandbox, so they never see real keys.
# In production, set each value in Apps Script: Project Settings -> Script properties.
# If you copy this to .env for your own notes, .env is git-ignored. Never commit real values.

# Required
TG_BOT_TOKEN=
ADB_KEY=

# Optional: OpenSky API client (set both or neither; without them OpenSky is used anonymously)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: FlightAware AeroAPI, used only as a backup when AeroDataBox fails or is out of budget
FA_KEY=
