{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 60,
      "includeFiles": "{src,engine,local-assistant/src}/**"
    }
  }
}
