# Local Telegram assistant: copy this file to .env.local-assistant (git-ignored) and fill it in.
# Never commit the filled-in copy. Values are read only by local-assistant/src/config.js.

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather. Only ONE program may poll a bot's updates: see local-assistant/README.md.
TG_BOT_TOKEN=
# Comma-separated numeric chat ids that may ask questions. Everyone else gets no tracker information.
# Leave empty the first time: the worker then starts in setup mode and replies to each private chat with its id.
ALLOWED_CHAT_IDS=

# --- Supabase (read-only: select on the flights table) -----------------------------
# Supabase dashboard -> Project Settings -> API (Data API). The Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The anon / publishable key, NOT the service_role / secret key (that one bypasses row-level security and is refused).
# With RLS on, the anon role needs a SELECT policy on `flights` or every read comes back empty.
SUPABASE_ANON_KEY=

# --- Google Sheets (optional, kept alongside Supabase for now) ---------------------
# No tracker data is read from Sheets any more. Keep these if you already have them; they are used only by
# "npm run assistant:auth" (local-assistant/src/google.js, read-only scope).
GOOGLE_SPREADSHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Language model ------------------------------------------------------------
# LLM_PROVIDER=gemini uses Google AI Studio (Gemini) through Google's @google/genai SDK:
#   GEMINI_API_KEY from aistudio.google.com -> Get API key; GEMINI_MODEL defaults to gemini-3.5-flash-lite
#   (answers in about 1-5 s; the bigger gemini-3.8-flash took 15-50 s on the free tier).
# Anything else (or blank) uses the OpenAI-compatible endpoint below (Ollama, vLLM, a DGX).
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible chat-completions endpoint (used when LLM_PROVIDER is not gemini)
# Local Ollama default. For a DGX or another server, change these three lines only.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=your-model-name
# Required whenever the endpoint is reachable beyond a trusted network. Leave empty for local Ollama.
LLM_API_KEY=
LLM_TIMEOUT_MS=30000

# --- Optional -----------------------------------------------------------------
# STATE_DIR=            default local-assistant/.state (Telegram offset; git-ignored)
# RATE_LIMIT_PER_MIN=6  questions per chat per minute
# MAX_QUESTION_CHARS=500

# --- Local preview dashboard (npm run preview) -----------------------------------
# Which columns the preview reads. flights (default) = the tracker's Flights columns (plus groups/status tables if present), the same data
# this bot reads, with live statuses. import = the Import columns' schedules only (no live status).
# With flights, a table without the tracker's columns falls back to Import and the page says so.
PREVIEW_SOURCE=flights
