# Tracking engine (engine/run.js) for LOCAL runs: copy to .env.engine (git-ignored) and fill it in.
# On Vercel, set the same names under Project Settings -> Environment Variables instead (plus CRON_SECRET).

# --- Supabase (server side only) ------------------------------------------------
# Project Settings -> API. The SERVICE ROLE / secret key: the engine writes Flights, groups, status and
# tracker_state. Never put it in the browser, the preview or local-assistant/.env.local-assistant.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flight data and alerts (the values Apps Script kept in Script Properties) --------
ADB_KEY=
TG_BOT_TOKEN=
# Optional
FA_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Vercel only ------------------------------------------------------------------
# Any long random string. Vercel sends it to /api/cron; every other caller is refused.
# CRON_SECRET=
